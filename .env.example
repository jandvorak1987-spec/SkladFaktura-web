# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# B2B Webhook (Nerx B2B -> SkladFaktura)
# B2B_WEBHOOK_TOKEN: Secret Bearer token shared between Nerx B2B and SkladFaktura-web.
B2B_WEBHOOK_TOKEN=
# FIREBASE_SYNC_EMAIL & FIREBASE_SYNC_PASSWORD: Email/password of a SkladFaktura workspace member used to write synced B2B orders, invoices & stock movements to Firestore.
FIREBASE_SYNC_EMAIL=
FIREBASE_SYNC_PASSWORD=
# Optional explicit IDs when multiple workspaces/companies/warehouses exist:
B2B_WORKSPACE_ID=
B2B_COMPANY_ID=
B2B_WAREHOUSE_ID=

