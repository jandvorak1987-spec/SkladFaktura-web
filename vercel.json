{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai-stock-import.js": {
      "maxDuration": 60
    },
    "api/nerx-categorize.js": {
      "maxDuration": 60
    },
    "api/b2b-webhook.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
